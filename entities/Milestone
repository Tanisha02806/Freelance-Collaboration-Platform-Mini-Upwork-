{
  "name": "Milestone",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "client_id": {
      "type": "string"
    },
    "freelancer_id": {
      "type": "string"
    },
    "submission_note": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title",
    "amount"
  ]
}